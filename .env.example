# Copie ce fichier en .env (jamais commité). Les clés restent côté serveur.
PORT=8787
# Fournisseur par défaut des bots : anthropic | openai | gemini | compatible | none
AI_PROVIDER=none
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# API compatible OpenAI (Ollama, LM Studio, vLLM…)
COMPAT_BASE_URL=http://localhost:11434/v1
COMPAT_API_KEY=
# Budget global d'appels LLM par partie (au-delà : phrases générées localement)
AI_CALL_BUDGET_PER_GAME=300
AI_TIMEOUT_MS=20000
