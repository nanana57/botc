{
  "name": "minuit-au-clocher",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "Plateforme de jeu de déduction sociale compatible avec les règles de Blood on the Clocktower (projet de fan non officiel).",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "npm run build && tsx src/server/index.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
